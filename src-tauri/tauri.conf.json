{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coplayer",
  "version": "0.1.0",
  "identifier": "dev.coplayer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Coplayer",
        "width": 960,
        "height": 680,
        "minWidth": 480,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "macOS": { "minimumSystemVersion": "14.0" },
    "resources": { "runtime/codex": "runtime/codex" },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
